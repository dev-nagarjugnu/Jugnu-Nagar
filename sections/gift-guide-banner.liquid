{% comment %}
  Gift Guide Banner - Pixel Perfect Figma Implementation
  - Top Bar: 64px
  - Top Image: 1440px (Full Width)
  - Bottom Row: Content (550px) | Bottom Image (890px)
  - Seamless Stitching: 12px overlap calculated from Figma 'top' values
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500&display=swap');

  /* Root reset for the section to ensure edge-to-edge 1440px */
  .gg-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    background: #FFFFFF;
    position: relative;
    overflow: hidden;
  }

  /* PART 1 - TOP BAR (64px) */
  .gg-topbar {
    height: 64px;
    background: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 67px; /* Aligning with button/text left margin */
    box-sizing: border-box;
  }

  .gg-topbar__text {
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    color: #000000;
  }

  .gg-topbar__btn {
    background: #FFF544;
    color: #000000;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    text-transform: uppercase;
  }

  /* PART 2 - HERO SECTION */
  .gg-hero {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Top Image: Full Width 1440px */
  .gg-hero__top-frame {
    width: 100%;
    height: 390px;
    line-height: 0;
  }

  .gg-hero__top-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Bottom Row: Text Left (550px) | Image Right (890px) */
  .gg-hero__bottom-row {
    display: flex;
    width: 100%;
    margin-top: -12px; /* Figma overlap: Top ends at 454, Bottom starts at 442 */
    position: relative;
    z-index: 2;
  }

  /* Content Left: 550px */
  .gg-hero__content {
    width: 550px;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    padding-left: 67px; /* From Figma: left: 67px */
    padding-top: 47px;  /* Figma Title 489px - Row Start 442px */
    box-sizing: border-box;
  }

  .gg-hero__title {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: 70px;
    line-height: 100%;
    margin: 0 0 50px 0; /* Space to description */
    color: #000000;
  }

  .gg-hero__desc {
    font-family: 'Jost', sans-serif;
    font-size: 20px;
    line-height: 140%;
    max-width: 483px; /* From Figma */
    margin: 0 0 50px 0; /* Space to CTA */
    color: #000000;
  }

  .gg-hero__cta {
    width: 220px;
    height: 50px;
    background: #000000;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    text-transform: uppercase;
  }

  /* Image Right: 890px */
  .gg-hero__bottom-frame {
    width: 890px;
    height: 402px;
    line-height: 0;
  }

  .gg-hero__bottom-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* PART 3 - TICKER */
  .gg-ticker {
    height: 34px;
    background: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .gg-ticker p {
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* MOBILE RESPONSIVE */
  @media screen and (max-width: 1024px) {
    .gg-hero__bottom-row { flex-direction: column; margin-top: 0; }
    .gg-hero__content { width: 100%; padding: 40px 20px; align-items: center; text-align: center; }
    .gg-hero__bottom-frame { width: 100%; height: auto; }
    .gg-hero__title { font-size: 48px; }
    .gg-topbar { padding: 0 20px; }
  }
</style>

<div class="gg-container">
  
  <!-- Part 1: Top Bar -->
  <div class="gg-topbar">
    <span class="gg-topbar__text">Find the ideal gift for your loved ones.</span>
    <a href="{{ section.settings.top_url }}" class="gg-topbar__btn">CHOOSE GIFT &nbsp; &rarr;</a>
  </div>

  <!-- Part 2: Main Hero -->
  <div class="gg-hero">
    
    <!-- Top Illustration (Full Width) -->
    <div class="gg-hero__top-frame">
      <img src="https://cdn.shopify.com/s/files/1/0787/4730/4121/files/top-banner-frame.png?v=1777978681" 
           alt="Gift Guide Illustration Top" 
           class="gg-hero__top-img" 
           width="1440" height="390" loading="eager">
    </div>

    <!-- Bottom Row (Split Content/Image) -->
    <div class="gg-hero__bottom-row">
      <div class="gg-hero__content">
        <h1 class="gg-hero__title">The Gift Guide</h1>
        <p class="gg-hero__desc">
          Discover Joy: Your Ultimate Holiday Gift Destination. 
          Explore our curated selection and find the perfect gifts to 
          delight your loved ones this holiday season.
        </p>
        <a href="{{ section.settings.cta_url }}" class="gg-hero__cta">SHOP NOW &nbsp; &rarr;</a>
      </div>

      <div class="gg-hero__bottom-frame">
        <img src="https://cdn.shopify.com/s/files/1/0787/4730/4121/files/bottom-banner-frame.png?v=1777978681" 
             alt="Gift Guide Illustration Bottom" 
             class="gg-hero__bottom-img" 
             width="890" height="402" loading="lazy">
      </div>
    </div>

  </div>

  <!-- Part 3: Ticker -->
  <div class="gg-ticker">
    <p>SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</p>
  </div>

</div>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    { "type": "url", "id": "top_url", "label": "Top Button Link" },
    { "type": "url", "id": "cta_url", "label": "Shop Now Link" }
  ],
  "presets": [{ "name": "Gift Guide Banner" }]
}
{% endschema %}