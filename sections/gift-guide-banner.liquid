{% comment %}
  Gift Guide Banner Section
  - Matches Figma Desktop-22 exactly
  - Left 40%: text content (title, subtitle, button)
  - Right 60%: two stacked illustration frames (top + bottom)
  - Font: Jost as specified in Figma CSS
  - No jQuery used anywhere
{% endcomment %}

<style>
  /* =====================
     Top bar
     Height 64px, grey #F5F5F5 as per Figma
  ===================== */
  .gg-topbar {
    display: flex;
    align-items: center;
    justify-content: center;
    align-items: center;
    padding: 10px 50px;
    gap: 360px;
    width: 100%;
    height: 64px;
    background: #F5F5F5;
    box-sizing: border-box;
  }

  .gg-topbar__content {
    width: 100%;
    max-width: 1340px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .gg-topbar__text {
    font-family: var(--gg-font-family);
    font-size: 16px;
    font-weight: 400;
    color: var(--gg-black);
  }

  .gg-topbar__btn {
    display: inline-flex;
    align-items: center;
    background: #FFF544;
    color: #000000;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 12px 20px;
    white-space: nowrap;
  }

  /* PART 2 - MAIN BANNER (780px) */
  .gg-banner {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: 780px;
    background: #FFFFFF;
    overflow: hidden;
    font-family: 'Jost', sans-serif;
  }

  /* Left side — 40% width, text vertically centered */
  .gg-banner__left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 0 67px;
    width: 40%;
    flex-shrink: 0;
    z-index: 2;
  }

  /* Right side — 60% width, two images stacked */
  .gg-banner__right {
    width: 60%;
    height: 780px;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    overflow: hidden;
    background: #FFFFFF;
    line-height: 0;
  }

  /* Each illustration image takes exactly half the height */
  .gg-banner__img {
    width: 100%;
    height: 390px;
    object-fit: cover;
    object-position: top center;
    display: block;
    background: #FFFFFF;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
  }

  .gg-banner__title {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    line-height: 1.1;
    margin: 0 0 20px 0;
  }

  .gg-banner__subtitle {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    line-height: 1.4;
    max-width: 483px;
  }

  /* SHOP NOW button — black as per Figma */
  .gg-banner__btn {
    margin-top: 0;
    display: inline-flex;
    align-items: center;
    background: #000000;
    color: #FFFFFF;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
    width: 220px;
    height: 50px;
    box-sizing: border-box;
    letter-spacing: 1px;
  }

  /* =====================
     Bottom ticker
     Height 34px, grey #F5F5F5 as per Figma
  ===================== */
  .gg-ticker {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    margin: 0;
  }

  /* PART 3 - BOTTOM TICKER (34px) */
  .gg-ticker {
    height: 34px;
    background: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .gg-ticker p {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: #000000;
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* =====================
     Mobile responsive
  ===================== */
  @media (max-width: 768px) {
    .gg-banner {
      flex-direction: column;
      height: auto;
    }
    .gg-banner__left {
      width: 100%;
      padding: 40px 20px;
    }
    .gg-banner__right {
      width: 100%;
      height: 400px;
    }
    .gg-banner__img {
      height: 200px;
    }
    .gg-banner__title {
      font-size: 40px;
    }
    .gg-banner__subtitle {
      font-size: 16px;
    }
    .gg-topbar {
      flex-direction: column;
      gap: 10px;
      height: auto;
      padding: 15px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}