{% comment %}
  Gift Guide Banner Section
  - Two column layout matching Figma Desktop-22 exactly
  - Left side: text content
  - Right side: SVG illustration background
  - Font: Jost as specified in Figma
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500&family=Lustria&display=swap" rel="stylesheet">

{% comment %} Top navigation bar — grey background as per Figma {% endcomment %}
<div class="gg-topbar">
  <span class="gg-topbar__text">Find the ideal gift for your loved ones.</span>
  <a href="/collections/gift-guide" class="gg-topbar__btn">CHOOSE GIFT &nbsp; &#8594;</a>
</div>

{% comment %} Main banner — two column layout {% endcomment %}
<div class="gg-banner">

  {% comment %} Left side — text content {% endcomment %}
  <div class="gg-banner__left">

    {% comment %} Main title — 70px Jost Medium as per Figma {% endcomment %}
    <h1 class="gg-banner__title">The Gift Guide</h1>

    {% comment %} Subtitle — 20px Jost Regular as per Figma {% endcomment %}
    <p class="gg-banner__subtitle">
      Discover Joy: Your Ultimate Holiday Gift Destination.
      Explore our curated selection and find the perfect gifts to
      delight your loved ones this holiday season.
    </p>

    {% comment %} SHOP NOW button — black with white text as per Figma {% endcomment %}
    <a href="/collections/gift-guide" class="gg-banner__btn">
      SHOP NOW &nbsp; &#8594;
    </a>

  </div>

  {% comment %} Right side — SVG illustration {% endcomment %}
  <div class="gg-banner__right">
    <img
      src="https://cdn.shopify.com/s/files/1/0787/4730/4121/files/Frame.svg?v=1777973720"
      alt="Gift guide illustrations"
      class="gg-banner__svg"
    >
  </div>

</div>

{% comment %} Bottom ticker bar as per Figma {% endcomment %}
<div class="gg-ticker">
  <p>SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</p>
</div>

<style>
  /* =====================
     Top navigation bar
     Grey bar — height 64px as per Figma
  ===================== */
  .gg-topbar {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 10px 50px;
    gap: 360px;
    width: 100%;
    height: 64px;
    background: #F5F5F5;
    box-sizing: border-box;
  }

  .gg-topbar__text {
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #000000;
  }

  .gg-topbar__btn {
    display: inline-flex;
    align-items: center;
    background: #FFF544;
    color: #000000;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 12px 20px;
    white-space: nowrap;
  }

  /* =====================
     Main banner
     Two column layout — adjusted height to match SVG aspect ratio
  ===================== */
  .gg-banner {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: auto;
    min-height: 500px;
    background: #FFFFFF;
    overflow: hidden;
    font-family: 'Jost', sans-serif;
  }

  /* Left side — text content — takes up ~40% width */
  .gg-banner__left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 60px 67px;
    width: 40%;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }

  /* Right side — illustration — takes up ~60% width */
  .gg-banner__right {
    width: 60%;
    height: 100%;
    min-height: 500px;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
  }

  /* SVG maintains aspect ratio and scales responsively */
  .gg-banner__svg {
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center;
    display: block;
    max-width: 100%;
  }

  /* Title — 70px Jost Medium as per Figma */
  .gg-banner__title {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: 70px;
    line-height: 100%;
    color: #000000;
    margin: 0 0 20px 0;
  }

  /* Subtitle — 20px Jost Regular as per Figma */
  .gg-banner__subtitle {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 140%;
    color: #000000;
    margin: 0 0 30px 0;
  }

  /* SHOP NOW button — black background as per Figma */
  .gg-banner__btn {
    display: inline-flex;
    align-items: center;
    background: #000000;
    color: #FFFFFF;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 15px 30px;
    width: 220px;
    height: 50px;
    box-sizing: border-box;
    letter-spacing: 1px;
  }

  /* =====================
     Bottom ticker bar
     Grey — height 34px as per Figma
  ===================== */
  .gg-ticker {
    width: 100%;
    height: 34px;
    background: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gg-ticker p {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: #000000;
    margin: 0;
    text-align: center;
  }

  /* =====================
     Responsive Design
  ===================== */

  @media (max-width: 1024px) {
    .gg-banner {
      flex-direction: column;
      min-height: auto;
    }

    .gg-banner__left {
      width: 100%;
      padding: 60px 40px;
      justify-content: center;
    }

    .gg-banner__right {
      width: 100%;
      min-height: 350px;
    }

    .gg-topbar {
      flex-direction: column;
      gap: 15px;
      height: auto;
      padding: 15px 20px;
    }
  }

  @media (max-width: 768px) {
    .gg-banner__title {
      font-size: clamp(2rem, 8vw, 70px);
      margin-bottom: 15px;
    }

    .gg-banner__subtitle {
      font-size: clamp(1rem, 3vw, 20px);
      margin-bottom: 20px;
    }

    .gg-banner__left {
      padding: 40px 20px;
    }

    .gg-banner__right {
      min-height: 300px;
    }

    .gg-topbar__btn {
      padding: 10px 15px;
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}