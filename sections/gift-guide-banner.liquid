{% comment %}
  ==============================================================================
  SECTION: Gift Guide Banner (FINAL RECRUITMENT VERSION)
  ------------------------------------------------------------------------------
  - REQUIREMENTS: Vanilla JS Only, Pixel Perfect Figma Specs
  - MOBILE FIXES: Single-line ticker, Truncated description, Absolute positioning
  ==============================================================================
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --gg-font-jost: 'Jost', sans-serif;
    --gg-color-black: #000000;
    --gg-color-white: #FFFFFF;
    --gg-color-grey: #F5F5F5;
    --gg-color-yellow: #FFF544;
    --gg-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gg-banner-section {
    width: 100%;
    background-color: var(--gg-color-white);
    font-family: var(--gg-font-jost);
    overflow: hidden;
    position: relative;
  }

  /* BUTTON ANIMATIONS (Recruiter Requirement) */
  .gg-anim-btn {
    transition: var(--gg-transition);
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
  }

  .gg-anim-btn--yellow:hover {
    background-color: var(--gg-color-black) !important;
    color: var(--gg-color-yellow) !important;
  }

  .gg-anim-btn--black:hover {
    background-color: #333333 !important;
    letter-spacing: 0.5px;
  }

  .gg-anim-btn span {
    display: inline-block;
    transition: transform 0.3s ease;
    margin-left: 10px;
  }

  .gg-anim-btn:hover span {
    transform: translateX(5px);
  }

  /* ==========================================================================
     DESKTOP LAYOUT (1440px)
     ========================================================================== */
  .gg-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 50px;
    width: 100%;
    height: 64px;
    background: var(--gg-color-grey);
    box-sizing: border-box;
    border-bottom: 1px solid #e0e0e0;
  }

  .gg-hamburger { display: none; }

  .gg-topbar__logo {
    font-weight: 500;
    font-size: 20px;
    color: var(--gg-color-black);
    text-decoration: none;
    text-transform: uppercase;
    width: 151.44px;
  }

  .gg-topbar__text { font-size: 16px; color: var(--gg-color-black); }

  .gg-topbar__btn {
    width: 207px;
    height: 44px;
    background: var(--gg-color-yellow);
    color: var(--gg-color-black);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 14px;
  }

  .gg-hero { width: 100%; display: flex; flex-direction: column; }
  .gg-hero__top-frame { width: 100%; height: 390px; line-height: 0; }
  .gg-hero__top-img { width: 100%; height: 100%; object-fit: cover; }

  .gg-hero__bottom-row { display: flex; width: 100%; margin-top: -2px; }

  .gg-content-block {
    width: 550px;
    background: var(--gg-color-white);
    padding: 80px 0 80px 67px;
    box-sizing: border-box;
  }

  .gg-hero__title { font-weight: 500; font-size: 70px; line-height: 100%; margin: 0 0 30px 0; }
  .gg-hero__desc { font-weight: 400; font-size: 20px; line-height: 140%; max-width: 483px; margin: 0 0 40px 0; }
  
  .hide-desktop { display: none; } /* Used for mobile-only short text */

  .gg-hero__cta { width: 220px; height: 50px; background: var(--gg-color-black); color: var(--gg-color-white); text-transform: uppercase; }

  .gg-hero__right-frame { width: 890px; height: 402px; }
  .gg-hero__right-img { width: 100%; height: 100%; object-fit: cover; }

  .gg-ticker { height: 34px; background: var(--gg-color-grey); display: flex; align-items: center; justify-content: center; }
  .gg-ticker p { font-size: 14px; text-transform: uppercase; margin: 0; letter-spacing: 0.5px; }

  /* ==========================================================================
     MOBILE RESPONSIVE (EXACT FIGMA 375px SPECS)
     ========================================================================== */
  @media screen and (max-width: 767px) {
    .gg-banner-section { width: 100%; max-width: 375.44px; margin: 0 auto; }

    /* Header Mobile */
    .gg-topbar {
      height: 65px;
      padding: 23px 16px;
      justify-content: flex-start;
      gap: 78px;
      background: #F7F7F7;
      box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.15);
      border: none;
    }

    .gg-topbar__text, .gg-topbar__btn { display: none !important; }

    .gg-hamburger {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 18px;
      height: 10px;
    }
    .gg-hamburger span { width: 100%; height: 2px; background: #000; }

    .gg-topbar__logo { width: 151.44px; height: 19px; font-size: 18px; display: flex; align-items: center; }

    /* Hero Mobile */
    .gg-hero {
      height: 580px; 
      position: relative;
      background: #FFFFFF;
      display: block;
    }

    .gg-hero__top-frame { display: none; }
    .gg-hero__bottom-row { display: block; margin: 0; }
    .gg-content-block { padding: 0; width: 100%; background: transparent; }

    /* Absolute Elements Mobile */
    .gg-hero__title {
      position: absolute;
      width: 197px;
      left: calc(50% - 197px/2);
      top: 49px;
      font-size: 30px;
      text-align: center;
      margin: 0;
    }

    .gg-hero__desc {
      position: absolute;
      width: 340px;
      left: calc(50% - 340px/2);
      top: 103px;
      font-size: 16px;
      line-height: 1.3;
      text-align: center;
      margin: 0;
    }

    /* Logic to show short text on mobile, full on desktop */
    .hide-mobile { display: none !important; }
    .hide-desktop { display: block !important; }

    .gg-hero__cta {
      position: absolute;
      width: 193px;
      height: 45px;
      left: calc(50% - 193px/2);
      top: 337px;
      z-index: 10;
      font-size: 16px;
    }

    .gg-hero__right-frame {
      position: absolute;
      width: 686px;
      height: 421px;
      left: calc(50% - 686px/2 + 15.5px);
      top: 32%; 
      z-index: 1;
    }
    
    .gg-hero__right-img { object-fit: contain; }

    /* Ticker Mobile - Single Line Fix */
    .gg-ticker {
      height: 34px;
      width: 100%;
      background: #F5F5F5;
      padding: 0 5px;
      box-sizing: border-box;
      position: relative;
      z-index: 20;
    }

    .gg-ticker p {
      width: 100%;
      font-size: 11.5px; /* Sized to fit XXS to 6XL in one line */
      white-space: nowrap; /* FORCES ONE LINE */
      text-align: center;
      letter-spacing: 0.1px;
    }
  }
</style>

<div class="gg-banner-section">
  
  <header class="gg-topbar">
    <div class="gg-hamburger">
      <span></span><span></span><span></span>
    </div>
    
    <a href="/" class="gg-topbar__logo">{{ section.settings.logo_text }}</a>
    
    <span class="gg-topbar__text">{{ section.settings.tagline_text }}</span>
    
    <a href="{{ section.settings.top_btn_url }}" class="gg-topbar__btn gg-anim-btn gg-anim-btn--yellow">
      {{ section.settings.top_btn_label }} <span>&rarr;</span>
    </a>
  </header>

  <section class="gg-hero">
    <div class="gg-hero__top-frame">
      <img src="https://cdn.shopify.com/s/files/1/0787/4730/4121/files/top-banner-frame.png?v=1777978681" 
           class="gg-hero__top-img" width="1440" height="390" loading="eager" alt="Banner Top">
    </div>

    <div class="gg-hero__bottom-row">
      <div class="gg-content-block">
        <h1 class="gg-hero__title">{{ section.settings.hero_title }}</h1>
        
        <p class="gg-hero__desc">
          <!-- Short version for Mobile -->
          <span class="hide-desktop">Discover Joy: Your Ultimate Holiday Gift Destination.</span>
          <!-- Full version for Desktop -->
          <span class="hide-mobile">{{ section.settings.hero_desc }}</span>
        </p>
        
        <a href="{{ section.settings.hero_btn_url }}" class="gg-hero__cta gg-anim-btn gg-anim-btn--black">
          {{ section.settings.hero_btn_label }} <span>&rarr;</span>
        </a>
      </div>

      <div class="gg-hero__right-frame">
        <picture>
          <source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0787/4730/4121/files/mobile-banner.svg?v=1778058752">
          <img src="https://cdn.shopify.com/s/files/1/0787/4730/4121/files/bottom-banner-frame.png?v=1777978681" 
               class="gg-hero__right-img" width="890" height="402" loading="lazy" alt="Banner Illustration">
        </picture>
      </div>
    </div>
  </section>

  <div class="gg-ticker">
    <p>{{ section.settings.ticker_text }}</p>
  </div>
</div>

<script>
  /**
   * Banner interactions (vanilla JS only)
   * Keeps behavior scoped and avoids inline handlers/debug logs.
   */
  (function() {
    function initBanner() {
      const hamburger = document.querySelector('.gg-hamburger');
      if (!hamburger) return;

      // Lightweight state toggle for future mobile nav wiring.
      hamburger.addEventListener('click', function() {
        const isActive = hamburger.classList.toggle('is-active');
        hamburger.setAttribute('aria-expanded', isActive ? 'true' : 'false');
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBanner);
    } else {
      initBanner();
    }
  })();
</script>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo", "default": "TISSO VISON" },
    { "type": "text", "id": "tagline_text", "label": "Tagline", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "top_btn_label", "label": "Yellow Btn Text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "top_btn_url", "label": "Yellow Btn Link" },
    { "type": "text", "id": "hero_title", "label": "Title", "default": "The Gift Guide" },
    { "type": "textarea", "id": "hero_desc", "label": "Description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "text", "id": "hero_btn_label", "label": "Black Btn Text", "default": "SHOP NOW" },
    { "type": "url", "id": "hero_btn_url", "label": "Black Btn Link" },
    { "type": "text", "id": "ticker_text", "label": "Ticker Text", "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR" }
  ],
  "presets": [{ "name": "Gift Guide Banner" }]
}
{% endschema %}