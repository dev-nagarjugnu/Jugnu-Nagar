{% comment %}
  ==============================================================================
  SECTION: Gift Guide Banner (PIXEL PERFECT RECRUITMENT VERSION)
  ------------------------------------------------------------------------------
  - REQUIREMENTS: No jQuery (Vanilla JS Only), Pixel Perfect Figma Specs
  - MOBILE: 375px Absolute Layout implementation
  - DESKTOP: 1440px Fluid Layout implementation
  ==============================================================================
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --gg-font-jost: 'Jost', sans-serif;
    --gg-color-black: #000000;
    --gg-color-white: #FFFFFF;
    --gg-color-grey: #F5F5F5;
    --gg-color-yellow: #FFF544;
    --gg-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* RESET & BASE */
  .gg-banner-section {
    width: 100%;
    background-color: var(--gg-color-white);
    font-family: var(--gg-font-jost);
    overflow: hidden;
    position: relative;
  }

  /* BUTTON ANIMATIONS (Requirement: Animation on Buttons) */
  .gg-anim-btn {
    transition: var(--gg-transition);
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
  }

  .gg-anim-btn--yellow:hover {
    background-color: var(--gg-color-black) !important;
    color: var(--gg-color-yellow) !important;
  }

  .gg-anim-btn--black:hover {
    background-color: #333333 !important;
    letter-spacing: 0.5px;
  }

  .gg-anim-btn span {
    display: inline-block;
    transition: transform 0.3s ease;
    margin-left: 10px;
  }

  .gg-anim-btn:hover span {
    transform: translateX(5px);
  }

  /* ==========================================================================
     DESKTOP LAYOUT (1440px)
     ========================================================================== */
  .gg-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 50px;
    width: 100%;
    height: 64px;
    background: var(--gg-color-grey);
    box-sizing: border-box;
    border-bottom: 1px solid #e0e0e0;
  }

  .gg-hamburger { display: none; } /* Hide on Desktop */

  .gg-topbar__logo {
    font-weight: 500;
    font-size: 20px;
    color: var(--gg-color-black);
    text-decoration: none;
    text-transform: uppercase;
    width: 151.44px;
  }

  .gg-topbar__text {
    font-size: 16px;
    color: var(--gg-color-black);
  }

  .gg-topbar__btn {
    width: 207px;
    height: 44px;
    background: var(--gg-color-yellow);
    color: var(--gg-color-black);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 14px;
  }

  .gg-hero { width: 100%; display: flex; flex-direction: column; }
  .gg-hero__top-frame { width: 100%; height: 390px; line-height: 0; }
  .gg-hero__top-img { width: 100%; height: 100%; object-fit: cover; }

  .gg-hero__bottom-row {
    display: flex;
    width: 100%;
    margin-top: -5px; /* Prevent sub-pixel gaps */
  }

  .gg-content-block {
    width: 550px;
    background: var(--gg-color-white);
    padding: 80px 0 80px 67px;
    box-sizing: border-box;
  }

  .gg-hero__title { font-weight: 500; font-size: 70px; line-height: 100%; margin: 0 0 30px 0; }
  .gg-hero__desc { font-weight: 400; font-size: 20px; line-height: 140%; max-width: 483px; margin: 0 0 40px 0; }
  .gg-hero__cta { width: 220px; height: 50px; background: var(--gg-color-black); color: var(--gg-color-white); text-transform: uppercase; }

  .gg-hero__right-frame { width: 890px; height: 402px; }
  .gg-hero__right-img { width: 100%; height: 100%; object-fit: cover; }

  .gg-ticker { height: 34px; background: var(--gg-color-grey); display: flex; align-items: center; justify-content: center; }
  .gg-ticker p { font-size: 14px; text-transform: uppercase; margin: 0; letter-spacing: 0.5px; }

  /* ==========================================================================
     UPDATED MOBILE RESPONSIVE - PIXEL PERFECT FINAL VERSION
     ========================================================================== */
  
  @media screen and (max-width: 767px) {
    .gg-banner-section {
      width: 100%;
      max-width: 375.44px;
      margin: 0 auto;
      overflow: hidden;
    }

    /* 1. MOBILE INFO BAR (Component 189) */
    .gg-topbar {
      height: 65px;
      background: #F7F7F7;
      padding: 23px 16px;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 78px;
      box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.15);
      border: none;
      box-sizing: border-box;
    }

    .gg-topbar__text, .gg-topbar__btn { display: none !important; }

    .gg-hamburger {
      width: 18px;
      height: 10px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex: none;
    }
    .gg-hamburger span { width: 100%; height: 2px; background: #000; }

    .gg-topbar__logo {
      width: 151.44px;
      height: 19px;
      display: flex;
      align-items: center;
      font-size: 18px; 
    }

    /* 2. MOBILE HERO CONTAINER */
    .gg-hero {
      width: 375.44px;
      height: 580px; /* Adjusted to fit the image and ticker perfectly */
      display: block;
      position: relative;
      background: #FFFFFF;
    }

    .gg-hero__top-frame { display: none; }
    .gg-hero__bottom-row { display: block; width: 100%; height: 100%; margin: 0; }
    .gg-content-block { width: 100%; padding: 0; background: transparent; }

    /* 3. MOBILE TITLE & DESCRIPTION */
    .gg-hero__title {
      position: absolute;
      width: 197px;
      left: calc(50% - 197px/2);
      top: 49px;
      font-size: 30px;
      text-align: center;
      margin: 0;
    }

    .gg-hero__desc {
      position: absolute;
      width: 340px;
      left: calc(50% - 340px/2);
      top: 103px;
      font-size: 16px;
      line-height: 1.3;
      text-align: center;
      margin: 0;
    }

    /* Hide the extra text on mobile as requested */
    .desc-extra { display: none !important; }

    /* 4. MOBILE ILLUSTRATION (Figma Specs) */
    .gg-hero__right-frame {
      position: absolute;
      width: 686px;
      height: 421px;
      left: calc(50% - 686px/2 + 15.5px);
      top: 32%; /* Adjusted to sit behind button */
      z-index: 1;
    }
    
    .gg-hero__right-img { width: 100%; height: 100%; object-fit: contain; }

    /* 5. MOBILE CTA BUTTON */
    .gg-hero__cta {
      position: absolute;
      width: 193px;
      height: 45px;
      left: calc(50% - 193px/2);
      top: 337px;
      z-index: 10;
      padding: 13px 20px;
      font-size: 16px;
      box-sizing: border-box;
    }

    /* 6. MOBILE TICKER BAR (One-Line Fix) */
    .gg-ticker {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 34px;
      background: #F5F5F5;
      padding: 0 10px;
      box-sizing: border-box;
      position: relative;
      z-index: 20;
    }

    .gg-ticker p {
      width: 100%;
      font-size: 11px; /* Scaled down slightly to guarantee one-line fit */
      font-weight: 400;
      text-align: center;
      white-space: nowrap; /* FORCES ONE LINE */
      letter-spacing: 0.2px;
      margin: 0;
    }
  }
</style>

<div class="gg-banner-section">
  
  <!-- INFO BAR -->
  <header class="gg-topbar">
    <div class="gg-hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </div>
    
    <a href="/" class="gg-topbar__logo">
      {{ section.settings.logo_text }}
    </a>
    
    <span class="gg-topbar__text">{{ section.settings.tagline_text }}</span>
    
    <a href="{{ section.settings.top_btn_url }}" class="gg-topbar__btn gg-anim-btn gg-anim-btn--yellow">
      {{ section.settings.top_btn_label }} <span>&rarr;</span>
    </a>
  </header>

  <!-- HERO SECTION -->
  <section class="gg-hero">
    <div class="gg-hero__top-frame">
      <img src="https://cdn.shopify.com/s/files/1/0787/4730/4121/files/top-banner-frame.png?v=1777978681" 
           class="gg-hero__top-img" width="1440" height="390" loading="eager" alt="Banner Top">
    </div>

    <div class="gg-hero__bottom-row">
      <div class="gg-content-block">
        <h1 class="gg-hero__title">{{ section.settings.hero_title }}</h1>
        <p class="gg-hero__desc">{{ section.settings.hero_desc }}</p>
        
        <a href="{{ section.settings.hero_btn_url }}" class="gg-hero__cta gg-anim-btn gg-anim-btn--black">
          {{ section.settings.hero_btn_label }} <span>&rarr;</span>
        </a>
      </div>

      <div class="gg-hero__right-frame">
        <picture>
          <source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0787/4730/4121/files/mobile-banner.svg?v=1778058752">
          <img src="https://cdn.shopify.com/s/files/1/0787/4730/4121/files/bottom-banner-frame.png?v=1777978681" 
               class="gg-hero__right-img" width="890" height="402" loading="lazy" alt="Banner Illustration">
        </picture>
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <div class="gg-ticker">
    <p>{{ section.settings.ticker_text }}</p>
  </div>
</div>

<script>
  /**
   * VANILLA JS ONLY - Professional Structure
   */
  document.addEventListener('DOMContentLoaded', function() {
    const bannerInit = () => {
      const hamburger = document.querySelector('.gg-hamburger');
      if(hamburger) {
        hamburger.addEventListener('click', () => {
          // Add your mobile menu logic here if needed
        });
      }
    };
    bannerInit();
  });
</script>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo Text", "default": "TISSO VISION" },
    { "type": "text", "id": "tagline_text", "label": "Desktop Tagline", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "top_btn_label", "label": "Yellow Button Text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "top_btn_url", "label": "Yellow Button Link" },
    { "type": "text", "id": "hero_title", "label": "Title", "default": "The Gift Guide" },
    { "type": "textarea", "id": "hero_desc", "label": "Description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination." },
    { "type": "text", "id": "hero_btn_label", "label": "Black Button Text", "default": "SHOP NOW" },
    { "type": "url", "id": "hero_btn_url", "label": "Black Button Link" },
    { "type": "text", "id": "ticker_text", "label": "Ticker Text", "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR" }
  ],
  "presets": [{ "name": "Gift Guide Banner" }]
}
{% endschema %}