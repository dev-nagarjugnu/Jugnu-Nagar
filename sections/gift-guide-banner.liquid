{% comment %}
  Gift Guide Banner Section
  - Matches Figma Desktop-22 exactly
  - Left 40%: text content (title, subtitle, button)
  - Right 60%: two stacked illustration frames (top + bottom)
  - Font: Jost as specified in Figma CSS
  - No jQuery used anywhere
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500&display=swap" rel="stylesheet">

{% comment %} Top bar — grey with tagline and yellow CTA {% endcomment %}
<div class="gg-topbar">
  <span class="gg-topbar__text">Find the ideal gift for your loved ones.</span>
  <a href="/collections/gift-guide" class="gg-topbar__btn">CHOOSE GIFT &nbsp; &#8594;</a>
</div>

{% comment %} Main banner — left text, right illustration {% endcomment %}
<div class="gg-banner">

  {% comment %} Left side — text content as per Figma {% endcomment %}
  <div class="gg-banner__left">
    <h1 class="gg-banner__title">The Gift Guide</h1>
    <p class="gg-banner__subtitle">
      Discover Joy: Your Ultimate Holiday Gift Destination.
      Explore our curated selection and find the perfect gifts to
      delight your loved ones this holiday season.
    </p>
    <a href="/collections/gift-guide" class="gg-banner__btn">
      SHOP NOW &nbsp; &#8594;
    </a>
  </div>

  {% comment %} 
    Right side — two illustration frames stacked vertically
    Top frame covers upper half, bottom frame covers lower half
  {% endcomment %}
  <div class="gg-banner__right">

    {% comment %} Top illustration frame {% endcomment %}
    <img
      src="{{ 'top-banner-frame.png' | asset_url }}"
      alt="Gift guide top illustrations"
      class="gg-banner__img"
    >

    {% comment %} Bottom illustration frame {% endcomment %}
    <img
      src="{{ 'bottom-banner-frame.png' | asset_url }}"
      alt="Gift guide bottom illustrations"
      class="gg-banner__img"
    >

  </div>

</div>

{% comment %} Bottom ticker bar {% endcomment %}
<div class="gg-ticker">
  <p>SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</p>
</div>

<style>
  /* =====================
     Top bar
     Height 64px, grey #F5F5F5 as per Figma
  ===================== */
  .gg-topbar {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 10px 50px;
    gap: 360px;
    width: 100%;
    height: 64px;
    background: #F5F5F5;
    box-sizing: border-box;
  }

  .gg-topbar__text {
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #000000;
  }

  /* Yellow CTA button as per Figma */
  .gg-topbar__btn {
    display: inline-flex;
    align-items: center;
    background: #FFF544;
    color: #000000;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 12px 20px;
    white-space: nowrap;
  }

  /* =====================
     Main banner
     Total height 780px as per Figma
     Left 40% text | Right 60% illustration
  ===================== */
  .gg-banner {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: 780px;
    background: #FFFFFF;
    overflow: hidden;
    font-family: 'Jost', sans-serif;
  }

  /* Left side — 40% width, text vertically centered */
  .gg-banner__left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 0 67px;
    width: 40%;
    flex-shrink: 0;
    z-index: 2;
  }

  /* Right side — 60% width, two images stacked */
  .gg-banner__right {
    width: 60%;
    height: 780px;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    overflow: hidden;
    background: #FFFFFF;
    line-height: 0;
  }

  /* Each illustration image takes exactly half the height */
  .gg-banner__img {
    width: 100%;
    height: 390px;
    object-fit: cover;
    object-position: top center;
    display: block;
    background: #FFFFFF;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
  }

  /* Title — 70px Jost Medium as per Figma */
  .gg-banner__title {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: 70px;
    line-height: 100%;
    color: #000000;
    margin: 0 0 20px 0;
  }

  /* Subtitle — 20px Jost Regular as per Figma */
  .gg-banner__subtitle {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 140%;
    color: #000000;
    margin: 20px 0 30px 0;
    max-width: 483px;
  }

  /* SHOP NOW button — black as per Figma */
  .gg-banner__btn {
    margin-top: 0;
    display: inline-flex;
    align-items: center;
    background: #000000;
    color: #FFFFFF;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 15px 30px;
    width: 220px;
    height: 50px;
    box-sizing: border-box;
    letter-spacing: 1px;
  }

  /* =====================
     Bottom ticker
     Height 34px, grey #F5F5F5 as per Figma
  ===================== */
  .gg-ticker {
    width: 100%;
    height: 34px;
    background: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gg-ticker p {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: #000000;
    margin: 0;
    text-align: center;
  }

  /* =====================
     Mobile responsive
  ===================== */
  @media (max-width: 768px) {
    .gg-banner {
      flex-direction: column;
      height: auto;
    }
    .gg-banner__left {
      width: 100%;
      padding: 40px 20px;
    }
    .gg-banner__right {
      width: 100%;
      height: 400px;
    }
    .gg-banner__img {
      height: 200px;
    }
    .gg-banner__title {
      font-size: 40px;
    }
    .gg-banner__subtitle {
      font-size: 16px;
    }
    .gg-topbar {
      flex-direction: column;
      gap: 10px;
      height: auto;
      padding: 15px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}