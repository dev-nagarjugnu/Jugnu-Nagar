{% comment %}
  Gift Guide Banner - PRO VERSION
  - Pixel Perfect Layout (12px overlap)
  - Animated Buttons (Sliding Arrow effect)
  - All text editable via Shopify Customizer
  - 100% Vanilla CSS & Liquid
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500&display=swap');

  /* Container Reset */
  .gg-section-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    background: #FFFFFF;
    position: relative;
    overflow: hidden;
  }

  /* =============================================
     ANIMATIONS & HOVER EFFECTS
     ============================================= */
  .gg-topbar__btn, .gg-hero__cta {
    transition: all 0.3s ease;
    cursor: pointer;
  }

  /* Yellow Button Hover */
  .gg-topbar__btn:hover {
    background-color: #000000 !important;
    color: #FFF544 !important;
    transform: translateY(-2px);
  }

  /* Black Button Hover */
  .gg-hero__cta:hover {
    background-color: #333333 !important;
    transform: translateY(-2px);
    letter-spacing: 1px;
  }

  /* Sliding Arrow Animation */
  .gg-topbar__btn span, .gg-hero__cta span {
    display: inline-block;
    transition: transform 0.3s ease;
    margin-left: 8px;
  }

  .gg-topbar__btn:hover span, .gg-hero__cta:hover span {
    transform: translateX(6px);
  }

  /* =============================================
     PART 1: INFO BAR (Frame 1956)
     ============================================= */
  .gg-topbar {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 10px 50px;
    gap: 360px; 
    width: 100%;
    height: 64px;
    background: #F5F5F5;
    box-sizing: border-box;
  }

  .gg-topbar__logo {
    width: 151.44px;
    height: 19px;
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: 20px;
    color: #000000;
    text-decoration: none;
    display: flex;
    align-items: center;
    flex: none;
    order: 0;
  }

  .gg-topbar__text {
    width: 260px;
    height: 14px;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 13px;
    display: flex;
    align-items: center;
    text-align: center;
    color: #000000;
    flex: none;
    order: 1;
  }

  .gg-topbar__btn {
    width: 207px;
    height: 44px;
    background: #FFF544;
    color: #000000;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    flex: none;
    order: 2;
  }

  /* =============================================
     PART 2: HERO SECTION
     ============================================= */
  .gg-hero {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .gg-hero__top-frame {
    width: 100%;
    height: 390px;
    line-height: 0;
  }

  .gg-hero__top-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gg-hero__bottom-row {
    display: flex;
    width: 100%;
    margin-top: -12px; 
    position: relative;
    z-index: 2;
  }

  .gg-hero__content {
    width: 550px;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    padding-left: 67px;
    padding-top: 47px;
    box-sizing: border-box;
  }

  .gg-hero__title {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: 70px;
    line-height: 100%;
    margin: 0 0 50px 0;
    color: #000000;
  }

  .gg-hero__desc {
    font-family: 'Jost', sans-serif;
    font-size: 20px;
    line-height: 140%;
    max-width: 483px;
    margin: 0 0 50px 0;
    color: #000000;
  }

  .gg-hero__cta {
    width: 220px;
    height: 50px;
    background: #000000;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    text-transform: uppercase;
  }

  .gg-hero__bottom-frame {
    width: 890px;
    height: 402px;
    line-height: 0;
  }

  .gg-hero__bottom-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* PART 3: TICKER */
  .gg-ticker {
    height: 34px;
    background: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .gg-ticker p {
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    margin: 0;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 1200px) {
    .gg-topbar { gap: 100px; padding: 10px 20px; }
  }

  @media screen and (max-width: 768px) {
    .gg-topbar { flex-direction: column; height: auto; gap: 15px; padding: 20px; }
    .gg-hero__bottom-row { flex-direction: column; margin-top: 0; }
    .gg-hero__content { width: 100%; padding: 40px 20px; align-items: center; text-align: center; }
    .gg-hero__bottom-frame { width: 100%; height: auto; }
    .gg-hero__title { font-size: 40px; }
  }
</style>

<div class="gg-section-container">
  
  <!-- Info Bar -->
  <div class="gg-topbar">
    <a href="/" class="gg-topbar__logo">{{ section.settings.logo_text }}</a>
    <span class="gg-topbar__text">{{ section.settings.tagline_text }}</span>
    <a href="{{ section.settings.top_url }}" class="gg-topbar__btn">
      {{ section.settings.top_btn_text }} <span>&rarr;</span>
    </a>
  </div>

  <!-- Hero -->
  <div class="gg-hero">
    <div class="gg-hero__top-frame">
      <img src="https://cdn.shopify.com/s/files/1/0787/4730/4121/files/top-banner-frame.png?v=1777978681" 
           alt="Gift Guide Top" class="gg-hero__top-img" width="1440" height="390" loading="eager">
    </div>

    <div class="gg-hero__bottom-row">
      <div class="gg-hero__content">
        <h1 class="gg-hero__title">{{ section.settings.hero_title }}</h1>
        <p class="gg-hero__desc">{{ section.settings.hero_desc }}</p>
        <a href="{{ section.settings.cta_url }}" class="gg-hero__cta">
          {{ section.settings.cta_text }} <span>&rarr;</span>
        </a>
      </div>

      <div class="gg-hero__bottom-frame">
        <img src="https://cdn.shopify.com/s/files/1/0787/4730/4121/files/bottom-banner-frame.png?v=1777978681" 
             alt="Gift Guide Bottom" class="gg-hero__bottom-img" width="890" height="402" loading="lazy">
      </div>
    </div>
  </div>

  <!-- Ticker -->
  <div class="gg-ticker">
    <p>{{ section.settings.ticker_text }}</p>
  </div>

</div>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "header",
      "content": "Top Bar Settings"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISION"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Tagline Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_btn_text",
      "label": "Top Button Label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_url",
      "label": "Top Button Link"
    },
    {
      "type": "header",
      "content": "Hero Content Settings"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Main Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "hero_desc",
      "label": "Main Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Shop Now Link"
    },
    {
      "type": "header",
      "content": "Ticker Settings"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}