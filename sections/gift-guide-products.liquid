{% comment %}
  ==============================================================================
  SECTION: Gift Guide Products (PIXEL PERFECT RECRUITMENT VERSION)
  ------------------------------------------------------------------------------
  - REQUIREMENT 1: "Selectable from customizer" -> via product_list setting.
  - REQUIREMENT 2: "Popup UI" -> Fixed 311px x 447px, Color above Size.
  - REQUIREMENT 3: "Add to Cart" -> Vanilla JS with AJAX.
  - REQUIREMENT 4: "Bonus Logic" -> Black + Medium = Auto-add Soft Winter Jacket.
  - MOBILE: 2-column grid layout (Figma Specs).
  ==============================================================================
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Lustria&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --gg-jost: 'Jost', sans-serif;
    --gg-lustria: 'Lustria', serif;
    --gg-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* --- 1. SECTION GRID STYLES --- */
  .gg-prod-section {
    max-width: 1440px;
    margin: 80px auto;
    padding: 0 50px;
    font-family: var(--gg-jost);
  }

  .gg-prod__heading {
    font-family: var(--gg-lustria);
    font-size: 36px;
    font-weight: 400;
    margin-bottom: 40px;
    text-align: center;
    color: #000;
    text-transform: capitalize;
  }

  .gg-prod__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .gg-prod__card {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .gg-prod__image-wrap {
    position: relative;
    aspect-ratio: 433 / 444; /* Exact Figma Ratio */
    overflow: hidden;
    background: #f4f4f4;
  }

  .gg-prod__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .gg-prod__card:hover img {
    transform: scale(1.08);
  }

  /* ADD BUTTON (Figma Specifics) */
  .gg-prod__plus-btn {
    position: absolute;
    bottom: 24px;
    right: 24px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    padding: 0;
    transition: var(--gg-transition);
  }

  .gg-prod__plus-btn:hover {
    background: #000000;
    color: #FFFFFF;
  }

  /* --- 2. MODAL / POPUP (FIGMA: 311px x 447px) --- */
  .gg-modal-root {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .gg-modal-root.is-active { display: flex; }

  .gg-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }

  .gg-modal-container {
    position: relative;
    width: 311px;
    height: 447px;
    background: #FFFFFF;
    box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.2);
    z-index: 10;
    padding: 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .gg-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    background: none;
    border: none;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    z-index: 20;
  }

  /* Modal Content UI */
  .qv-header { display: flex; gap: 15px; margin-bottom: 20px; height: 135px; flex-shrink: 0; }
  .qv-img-box { width: 120px; height: 135px; flex-shrink: 0; overflow: hidden; background: #eee; }
  .qv-img-box img { width: 100%; height: 100%; object-fit: cover; }
  
  .qv-text-box { flex-grow: 1; padding-top: 2px; overflow: hidden; }
  .qv-title { font-family: var(--gg-jost); font-weight: 300; font-size: 16px; line-height: 1.2; margin: 0 0 6px; color: #000; text-transform: uppercase; }
  .qv-price { font-family: var(--gg-lustria); font-weight: 400; font-size: 16px; margin-bottom: 8px; color: #000; }
  .qv-desc { 
    font-family: var(--gg-jost); font-weight: 300; font-size: 13px; 
    line-height: 1.3; color: #000;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* Segmented Controls (Color/Size UI) */
  .qv-option-label { font-family: var(--gg-jost); font-size: 14px; font-weight: 400; color: #333; margin-bottom: 6px; display: block; text-transform: uppercase; }
  .qv-segmented-control { display: flex; border: 1px solid #000; width: 100%; margin-bottom: 15px; height: 38px; }
  .qv-segment { flex: 1; display: flex; align-items: center; justify-content: center; font-size: 14px; cursor: pointer; transition: 0.2s; }
  .qv-segment:not(:last-child) { border-right: 1px solid #000; }
  .qv-segment.selected { background: #000; color: #FFF; }

  .qv-select-wrap { position: relative; margin-bottom: 20px; }
  .qv-select { width: 100%; height: 40px; border: 1px solid #000; background: #fff; font-family: var(--gg-jost); font-size: 14px; padding: 0 10px; appearance: none; border-radius: 0; }
  .qv-select-wrap::after { content: '⌄'; position: absolute; right: 12px; top: 8px; pointer-events: none; font-size: 18px; }

  /* Animated ATC Button */
  .qv-atc-btn {
    margin-top: auto;
    width: 100%; height: 45px; background: #000; color: #FFF; border: none; font-family: var(--gg-jost); font-size: 14px; text-transform: uppercase;
    display: flex; align-items: center; justify-content: center; gap: 10px; cursor: pointer; transition: var(--gg-transition);
  }
  .qv-atc-btn span { transition: transform 0.3s ease; display: inline-block; }
  .qv-atc-btn:hover { background: #333; }
  .qv-atc-btn:hover span { transform: translateX(5px); }

  /* --- 3. MOBILE RESPONSIVE (FIGMA 2-COLUMN GRID) --- */
  @media (max-width: 767px) {
    .gg-prod-section { padding: 0 16px; margin: 40px auto; }
    .gg-prod__heading { font-size: 28px; margin-bottom: 24px; }
    
    /* FIGMA MOBILE REQUIREMENT: 2 COLUMNS */
    .gg-prod__grid { 
      grid-template-columns: repeat(2, 1fr); 
      gap: 12px; 
    }

    .gg-prod__plus-btn { bottom: 12px; right: 12px; width: 28px; height: 28px; }

    .gg-modal-container { 
      width: 311px; /* Keeping original Figma width for consistency */
      height: 447px; 
      max-height: 90vh;
    }
  }
</style>

<div class="gg-prod-section">
  <h2 class="gg-prod__heading">{{ section.settings.heading }}</h2>
  
  <div class="gg-prod__grid">
    {% assign products_to_display = section.settings.product_list %}
    {% if products_to_display == blank %}
      {% assign products_to_display = collections[section.settings.collection].products %}
    {% endif %}

    {% for product in products_to_display limit: 6 %}
      <div class="gg-prod__card">
        <div class="gg-prod__image-wrap">
          <img src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ product.title | escape }}" loading="lazy">
          <button type="button" class="gg-prod__plus-btn js-open-modal" data-handle="{{ product.handle }}">
            <span>+</span>
          </button>
        </div>
        {% comment %} JSON data for the Vanilla JS engine {% endcomment %}
        <script type="application/json" id="DATA-{{ product.handle }}">
          {{ product | json }}
        </script>
      </div>
    {% endfor %}
  </div>
</div>

{% comment %} MODAL ROOT {% endcomment %}
<div id="GGModal" class="gg-modal-root">
  <div class="gg-modal-overlay js-close-modal"></div>
  <div class="gg-modal-container">
    <button class="gg-modal-close js-close-modal" aria-label="Close">&times;</button>
    <div id="GGModalContent" style="height:100%; display:flex; flex-direction:column;">
      {% comment %} Content injected by JS {% endcomment %}
    </div>
  </div>
</div>

<script>
/**
 * VANILLA JAVASCRIPT - MISSION CRITICAL LOGIC
 */
(function() {
  let currentProduct = null;
  let currentOptions = { option1: null, option2: null, option3: null };
  const BONUS_HANDLE = "{{ section.settings.bonus_product.handle | default: 'soft-winter-jacket' }}";

  function init() {
    // Modal Triggers
    document.querySelectorAll('.js-open-modal').forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault();
        const handle = btn.getAttribute('data-handle');
        loadProductModal(handle);
      };
    });

    // Close Actions
    document.querySelectorAll('.js-close-modal').forEach(btn => {
      btn.onclick = () => {
        document.getElementById('GGModal').classList.remove('is-active');
        document.body.style.overflow = '';
      };
    });
  }

  function loadProductModal(handle) {
    const dataEl = document.getElementById(`DATA-${handle}`);
    if (!dataEl) return;
    
    currentProduct = JSON.parse(dataEl.textContent);
    
    // Default to first variant
    const firstVar = currentProduct.variants[0];
    currentOptions.option1 = firstVar.option1;
    currentOptions.option2 = firstVar.option2;
    currentOptions.option3 = firstVar.option3;

    renderModalUI();
    document.getElementById('GGModal').classList.add('is-active');
    document.body.style.overflow = 'hidden';
  }

  window.updateSelection = (idx, val) => {
    currentOptions[`option${idx}`] = val;
    renderModalUI();
  };

  function renderModalUI() {
    const container = document.getElementById('GGModalContent');
    
    // Find active variant based on current selections
    const variant = currentProduct.variants.find(v => 
      v.option1 === currentOptions.option1 && 
      v.option2 === currentOptions.option2 && 
      v.option3 === currentOptions.option3
    ) || currentProduct.variants[0];

    const priceFormatted = (variant.price / 100).toFixed(2).replace('.', ',') + '€';
    const image = variant.featured_image ? variant.featured_image.src : currentProduct.featured_image;

    // Build Options HTML
    let optionsHtml = '';
    currentProduct.options.forEach((opt, index) => {
      const optName = typeof opt === 'string' ? opt : opt.name;
      const optIdx = index + 1;
      const values = [...new Set(currentProduct.variants.map(v => v[`option${optIdx}`]))];

      optionsHtml += `<label class="qv-option-label">${optName}</label>`;
      
      // COLOR as Segmented Control (as per Figma req)
      if (optName.toLowerCase().includes('color')) {
        optionsHtml += `<div class="qv-segmented-control">`;
        values.forEach(val => {
          const selectedClass = currentOptions[`option${optIdx}`] === val ? 'selected' : '';
          optionsHtml += `<div class="qv-segment ${selectedClass}" onclick="updateSelection(${optIdx}, '${val}')">${val}</div>`;
        });
        optionsHtml += `</div>`;
      } 
      // OTHERS (Size) as Dropdown
      else {
        optionsHtml += `<div class="qv-select-wrap"><select class="qv-select" onchange="updateSelection(${optIdx}, this.value)">`;
        values.forEach(val => {
          const selectedAttr = currentOptions[`option${optIdx}`] === val ? 'selected' : '';
          optionsHtml += `<option value="${val}" ${selectedAttr}>${val}</option>`;
        });
        optionsHtml += `</select></div>`;
      }
    });

    container.innerHTML = `
      <div class="qv-header">
        <div class="qv-img-box"><img src="${image}" alt="Product"></div>
        <div class="qv-text-box">
          <h3 class="qv-title">${currentProduct.title}</h3>
          <p class="qv-price">${priceFormatted}</p>
          <div class="qv-desc">${currentProduct.description.substring(0, 100)}...</div>
        </div>
      </div>
      <div class="qv-options-area">${optionsHtml}</div>
      <button class="qv-atc-btn" onclick="addToCart(${variant.id})">
        ADD TO CART <span>&rarr;</span>
      </button>
    `;
  }

  window.addToCart = async (variantId) => {
    const btn = document.querySelector('.qv-atc-btn');
    btn.innerHTML = "ADDING...";
    
    let itemsToAdd = [{ id: variantId, quantity: 1 }];
    
    // REQUIREMENT: Logic for Black + Medium Bonus
    const currentSelections = Object.values(currentOptions).map(v => v ? v.toLowerCase() : '');
    const isBlack = currentSelections.includes('black');
    const isMedium = currentSelections.includes('medium') || currentSelections.includes('m');

    if (isBlack && isMedium) {
      try {
        const bonusRes = await fetch(`/products/${BONUS_HANDLE}.js`);
        if (bonusRes.ok) {
          const bonusProd = await bonusRes.json();
          if (bonusProd.variants[0]) {
            itemsToAdd.push({ id: bonusProd.variants[0].id, quantity: 1 });
          }
        }
      } catch(e) { console.warn("Bonus logic bypassed", e); }
    }

    // Shopify AJAX Cart Call
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: itemsToAdd })
      });
      
      if (res.ok) {
        btn.innerHTML = "SUCCESS! ✓";
        setTimeout(() => window.location.reload(), 800);
      } else {
        throw new Error("Failed");
      }
    } catch (err) {
      btn.innerHTML = "ERROR - TRY AGAIN";
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% schema %}
{
  "name": "Gift Guide Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 6
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback Collection"
    },
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Bonus Product (Soft Winter Jacket)"
    }
  ],
  "presets": [{ "name": "Gift Guide Products" }]
}
{% endschema %}