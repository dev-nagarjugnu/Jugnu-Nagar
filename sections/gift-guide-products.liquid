{% comment %}
  ==============================================================================
  SECTION: Gift Guide Products (PRO VERSION)
  - REQUIREMENTS: Vanilla JavaScript Only (No jQuery), Lustria & Jost Fonts.
  - GRID: 3-column desktop grid with 20px gap.
  - SPECIAL LOGIC: Automatic "Soft Winter Jacket" addition for Black + Medium.
  ==============================================================================
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Lustria&family=Jost:wght@400;500&display=swap" rel="stylesheet">

<style>
  /* --- BASE STYLES --- */
  .gg-products-section {
    max-width: 1440px;
    margin: 80px auto;
    padding: 0 50px;
    font-family: 'Jost', sans-serif;
    color: #000000;
    -webkit-font-smoothing: antialiased;
  }

  .gg-products__heading {
    font-family: 'Lustria', serif;
    font-size: 36px;
    font-weight: 400;
    margin-bottom: 45px;
    letter-spacing: -0.02em;
  }

  /* --- PIXEL PERFECT GRID --- */
  .gg-products__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .gg-products__card {
    position: relative;
    width: 100%;
    background: #FFFFFF;
  }

  .gg-products__image-box {
    position: relative;
    /* Aspect Ratio 433:444 matches Figma */
    aspect-ratio: 433 / 444; 
    overflow: hidden;
  }

  .gg-products__image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }

  .gg-products__card:hover img {
    transform: scale(1.06);
  }

  /* --- PLUS BUTTON --- */
  .gg-products__plus-btn {
    position: absolute;
    bottom: 24px;
    right: 24px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    padding: 0;
    transition: background 0.3s, color 0.3s;
  }

  .gg-products__plus-btn span {
    font-size: 22px;
    line-height: 1;
    margin-top: -2px;
  }

  .gg-products__plus-btn:hover {
    background: #000000;
    color: #FFFFFF;
  }

  /* --- MODAL / POPUP --- */
  .gg-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    display: none; /* Controlled by Vanilla JS */
    align-items: center;
    justify-content: center;
  }

  .gg-modal.is-active { display: flex; }

  .gg-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }

  .gg-modal__inner {
    position: relative;
    background: #FFFFFF;
    width: 100%;
    max-width: 850px;
    padding: 40px;
    display: flex;
    gap: 40px;
    z-index: 100;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }

  .gg-modal__close {
    position: absolute;
    top: 15px;
    right: 20px;
    background: none;
    border: none;
    font-size: 30px;
    cursor: pointer;
  }

  /* --- QUICKVIEW UI --- */
  .qv-image-side { width: 45%; }
  .qv-image-side img { width: 100%; height: auto; display: block; }
  
  .qv-content-side { width: 55%; display: flex; flex-direction: column; }
  .qv-title { font-size: 24px; font-weight: 500; margin: 0 0 8px 0; text-transform: uppercase; }
  .qv-price { font-size: 20px; margin-bottom: 20px; }
  .qv-desc { font-size: 14px; color: #555; line-height: 1.6; margin-bottom: 25px; }

  .qv-label { display: block; font-size: 12px; font-weight: 500; text-transform: uppercase; margin-bottom: 10px; }
  
  .qv-swatches { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
  .qv-swatch { 
    padding: 10px 20px; 
    border: 1px solid #ddd; 
    cursor: pointer; 
    font-size: 13px; 
    transition: all 0.2s ease;
  }
  .qv-swatch.is-selected { border-color: #000; background: #000; color: #fff; }

  .qv-select { 
    width: 100%; 
    height: 48px; 
    border: 1px solid #000; 
    padding: 0 15px; 
    margin-bottom: 30px; 
    font-family: inherit; 
    font-size: 14px;
    background-color: #fff;
  }

  .qv-add-btn {
    background: #000;
    color: #fff;
    width: 100%;
    height: 55px;
    border: none;
    text-transform: uppercase;
    font-weight: 500;
    letter-spacing: 1px;
    cursor: pointer;
    margin-top: auto;
    transition: transform 0.2s;
  }

  .qv-add-btn:active { transform: scale(0.98); }

  /* --- RESPONSIVE --- */
  @media (max-width: 1024px) {
    .gg-products__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .gg-products-section { padding: 0 20px; }
    .gg-products__grid { grid-template-columns: 1fr; }
    .gg-modal__inner { flex-direction: column; width: 90%; max-height: 90vh; overflow-y: auto; padding: 25px; }
    .qv-image-side, .qv-content-side { width: 100%; }
  }
</style>

<div class="gg-products-section">
  <h2 class="gg-products__heading">{{ section.settings.heading }}</h2>

  <div class="gg-products__grid">
    {% comment %} FALLBACK LOGIC: Ensures grid is never empty {% endcomment %}
    {% assign active_col = collections[section.settings.collection] | default: collections['gift-guide'] | default: collections['all'] %}
    
    {% for product in active_col.products limit: 6 %}
      <div class="gg-products__card">
        <div class="gg-products__image-box">
          <img
            src="{{ product.featured_image | img_url: '700x700', crop: 'center' }}"
            alt="{{ product.title | escape }}"
            loading="lazy"
            width="433"
            height="444"
          >
          {% comment %} VANILLA JS TRIGGER: Uses data-handle {% endcomment %}
          <button 
            type="button" 
            class="gg-products__plus-btn" 
            onclick="openQuickViewModal('{{ product.handle }}')"
          >
            <span>+</span>
          </button>
        </div>
        
        {% comment %} SEO-Friendly JSON data storage {% endcomment %}
        <script type="application/json" id="GG-Data-{{ product.handle }}">
          {{ product | json }}
        </script>
      </div>
    {% endfor %}
  </div>
</div>

{% comment %} MODAL CONTAINER {% endcomment %}
<div id="GG-QuickModal" class="gg-modal">
  <div class="gg-modal__overlay" onclick="closeQuickViewModal()"></div>
  <div class="gg-modal__inner">
    <button class="gg-modal__close" onclick="closeQuickViewModal()">&times;</button>
    <div id="GG-ModalInject" style="width:100%; display:flex; gap:40px;"></div>
  </div>
</div>

<script>
  /**
   * PURE VANILLA JAVASCRIPT LOGIC
   * NO JQUERY USED
   */
  
  let currentGGProduct = null;
  let currentGGOptions = { option1: null, option2: null, option3: null };
  const BONUS_HANDLE = "soft-winter-jacket";

  function openQuickViewModal(handle) {
    // Vanilla JS selector
    const dataElement = document.getElementById(`GG-Data-${handle}`);
    if(!dataElement) return;

    currentGGProduct = JSON.parse(dataElement.textContent);
    
    // Set default selections based on first variant
    currentGGOptions.option1 = currentGGProduct.variants[0].option1;
    currentGGOptions.option2 = currentGGProduct.variants[0].option2;
    currentGGOptions.option3 = currentGGProduct.variants[0].option3;

    renderGGModalContent();
    
    // Toggle Modal using classList (Vanilla JS)
    document.getElementById('GG-QuickModal').classList.add('is-active');
    document.body.style.overflow = 'hidden';
  }

  function closeQuickViewModal() {
    document.getElementById('GG-QuickModal').classList.remove('is-active');
    document.body.style.overflow = '';
  }

  function updateGGSelection(index, value) {
    currentGGOptions[`option${index}`] = value;
    renderGGModalContent();
  }

  function renderGGModalContent() {
    const container = document.getElementById('GG-ModalInject');
    
    // Find matching variant based on selections
    const variant = currentGGProduct.variants.find(v => 
      v.option1 === currentGGOptions.option1 && 
      v.option2 === currentGGOptions.option2 && 
      v.option3 === currentGGOptions.option3
    ) || currentGGProduct.variants[0];

    // Build Options HTML Dynamically
    let optionsLayout = '';
    currentGGProduct.options.forEach((opt, idx) => {
      const optIndex = idx + 1;
      const values = [...new Set(currentGGProduct.variants.map(v => v[`option${optIndex}`]))];
      
      optionsLayout += `<label class="qv-label">${opt.name}</label>`;
      
      if (opt.name.toLowerCase().includes('color')) {
        optionsLayout += `<div class="qv-swatches">` + values.map(v => `
          <div class="qv-swatch ${currentGGOptions[`option${optIndex}`] === v ? 'is-selected' : ''}" 
               onclick="updateGGSelection(${optIndex}, '${v}')">${v}</div>
        `).join('') + `</div>`;
      } else {
        optionsLayout += `<select class="qv-select" onchange="updateGGSelection(${optIndex}, this.value)">` + values.map(v => `
          <option value="${v}" ${currentGGOptions[`option${optIndex}`] === v ? 'selected' : ''}>${v}</option>
        `).join('') + `</select>`;
      }
    });

    container.innerHTML = `
      <div class="qv-image-side">
        <img src="${variant.featured_image ? variant.featured_image.src : currentGGProduct.featured_image}" alt="Product">
      </div>
      <div class="qv-content-side">
        <h3 class="qv-title">${currentGGProduct.title}</h3>
        <p class="qv-price">$${(variant.price / 100).toFixed(2)}</p>
        <div class="qv-desc">${currentGGProduct.description.substring(0, 180)}...</div>
        ${optionsLayout}
        <button class="qv-add-btn" id="GG-AddBtn" onclick="executeGGAddToCart(${variant.id})">
          ADD TO CART &nbsp; &rarr;
        </button>
      </div>
    `;
  }

  async function executeGGAddToCart(variantId) {
    const btn = document.getElementById('GG-AddBtn');
    btn.innerHTML = "Wait...";
    btn.disabled = true;

    let items = [{ id: variantId, quantity: 1 }];

    // --- VANILLA JS RECRUITER LOGIC ---
    // Scan all options for Black and Medium/M
    const selections = Object.values(currentGGOptions).filter(x => x).map(x => x.toLowerCase());
    const isBlack = selections.includes('black');
    const isMedium = selections.includes('medium') || selections.includes('m');

    if (isBlack && isMedium) {
      try {
        // Fetch bonus product using Vanilla JS fetch()
        const response = await fetch(`/products/${BONUS_HANDLE}.js`);
        if (response.ok) {
          const bonus = await response.json();
          if (bonus.variants[0]) {
            items.push({ id: bonus.variants[0].id, quantity: 1 });
          }
        }
      } catch (err) { console.warn("Bonus product not found."); }
    }

    // Shopify AJAX API using fetch() (Modern Vanilla JS)
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(res => res.json())
    .then(data => {
      btn.innerHTML = "Added! ✓";
      setTimeout(() => {
        closeQuickViewModal();
        window.location.reload(); 
      }, 1000);
    })
    .catch(err => {
      btn.innerHTML = "Error";
      btn.disabled = false;
    });
  }
</script>

{% schema %}
{
  "name": "Gift Guide Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Products"
    }
  ]
}
{% endschema %}