{% comment %}
  ==============================================================================
  SECTION: Gift Guide Products (V3 - STABLE)
  - REQUIREMENTS: Vanilla JS, Lustria Heading, Jost Body.
  - FEATURES: QuickView Popup, Logic for Black + Medium = Bonus Jacket.
  - BUG FIX: Added Event Listeners to ensure Modal triggers every time.
  ==============================================================================
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Lustria&family=Jost:wght@400;500&display=swap" rel="stylesheet">

<style>
  /* --- SECTION WRAP --- */
  .gg-prod-container {
    max-width: 1440px;
    margin: 60px auto;
    padding: 0 50px;
    font-family: 'Jost', sans-serif;
    color: #000;
  }

  .gg-prod__heading {
    font-family: 'Lustria', serif;
    font-size: 36px;
    font-weight: 400;
    margin-bottom: 40px;
  }

  /* --- GRID 3x2 --- */
  .gg-prod__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .gg-prod__card {
    position: relative;
    width: 100%;
    line-height: 0;
  }

  .gg-prod__image-wrap {
    position: relative;
    aspect-ratio: 433 / 444; /* Exact Figma Ratio */
    overflow: hidden;
  }

  .gg-prod__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .gg-prod__card:hover img {
    transform: scale(1.05);
  }

  /* --- PLUS BUTTON --- */
  .gg-prod__plus-btn {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #FFF;
    border: 1px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    padding: 0;
    transition: 0.3s;
  }

  .gg-prod__plus-btn span {
    font-size: 22px;
    line-height: 1;
    font-weight: 400;
  }

  .gg-prod__plus-btn:hover {
    background: #000;
    color: #FFF;
  }

  /* --- MODAL STYLES --- */
  .gg-modal-root {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none; /* JS toggles this */
    align-items: center;
    justify-content: center;
  }

  .gg-modal-root.is-active { display: flex; }

  .gg-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
  }

  .gg-modal-container {
    position: relative;
    background: #FFF;
    width: 90%;
    max-width: 850px;
    padding: 40px;
    z-index: 10;
    display: flex;
    gap: 40px;
  }

  .gg-modal-close {
    position: absolute;
    top: 15px;
    right: 20px;
    background: none;
    border: none;
    font-size: 30px;
    cursor: pointer;
  }

  /* --- MODAL CONTENT UI --- */
  .qv-left { width: 45%; flex-shrink: 0; }
  .qv-left img { width: 100%; height: auto; display: block; }
  .qv-right { width: 55%; display: flex; flex-direction: column; }
  
  .qv-title { font-size: 22px; font-weight: 500; text-transform: uppercase; margin: 0 0 10px; }
  .qv-price { font-size: 18px; margin-bottom: 15px; }
  .qv-desc { font-size: 14px; line-height: 1.6; color: #555; margin-bottom: 20px; }

  .qv-label { font-size: 12px; font-weight: 500; text-transform: uppercase; margin-bottom: 8px; display: block; }
  .qv-swatches { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
  .qv-swatch { padding: 8px 16px; border: 1px solid #ddd; cursor: pointer; font-size: 13px; }
  .qv-swatch.selected { background: #000; color: #fff; border-color: #000; }
  
  .qv-select { width: 100%; height: 45px; border: 1px solid #000; margin-bottom: 25px; padding: 0 10px; }

  .qv-atc-btn {
    background: #000;
    color: #fff;
    width: 100%;
    height: 55px;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    font-weight: 500;
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .gg-prod__grid { grid-template-columns: 1fr; }
    .gg-modal-container { flex-direction: column; width: 95%; max-height: 90vh; overflow-y: auto; padding: 25px; }
    .qv-left, .qv-right { width: 100%; }
  }
</style>

<div class="gg-prod-container">
  <h2 class="gg-prod__heading">{{ section.settings.heading }}</h2>

  <div class="gg-prod__grid">
    {% comment %} Automatic collection fallback {% endcomment %}
    {% assign col = collections[section.settings.collection] | default: collections['gift-guide'] | default: collections['all'] %}
    
    {% for product in col.products limit: 6 %}
      <div class="gg-prod__card">
        <div class="gg-prod__image-wrap">
          <img src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ product.title }}" loading="lazy">
          <button type="button" class="gg-prod__plus-btn js-gg-plus" data-handle="{{ product.handle }}">
            <span>+</span>
          </button>
        </div>
        {% comment %} JSON data for JS to pick up {% endcomment %}
        <script type="application/json" id="Data-{{ product.handle }}">
          {{ product | json }}
        </script>
      </div>
    {% endfor %}
  </div>
</div>

{% comment %} MODAL ROOT {% endcomment %}
<div id="GG-Modal" class="gg-modal-root">
  <div class="gg-modal-overlay js-gg-close"></div>
  <div class="gg-modal-container">
    <button class="gg-modal-close js-gg-close">&times;</button>
    <div id="GG-Modal-Body" style="width:100%; display:flex; gap:40px;"></div>
  </div>
</div>

<script>
/**
 * VANILLA JAVASCRIPT - NO JQUERY
 */
(function() {
  let activeProd = null;
  let activeOptions = { option1: null, option2: null, option3: null };
  const BONUS_H = "soft-winter-jacket";

  // Initialize Event Listeners
  function init() {
    // Plus Buttons
    const btns = document.querySelectorAll('.js-gg-plus');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const h = btn.getAttribute('data-handle');
        openModal(h);
      });
    });

    // Close Buttons
    const closeBtns = document.querySelectorAll('.js-gg-close');
    closeBtns.forEach(btn => {
      btn.addEventListener('click', closeModal);
    });
  }

  function openModal(handle) {
    const dataStr = document.getElementById(`Data-${handle}`);
    if(!dataStr) { console.error("No product data found for", handle); return; }
    
    activeProd = JSON.parse(dataStr.textContent);
    
    // Set initial options
    activeOptions.option1 = activeProd.variants[0].option1;
    activeOptions.option2 = activeProd.variants[0].option2;
    activeOptions.option3 = activeProd.variants[0].option3;

    renderContent();
    document.getElementById('GG-Modal').classList.add('is-active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('GG-Modal').classList.remove('is-active');
    document.body.style.overflow = '';
  }

  window.setGGOpt = function(index, value) {
    activeOptions[`option${index}`] = value;
    renderContent();
  };

  function renderContent() {
    const body = document.getElementById('GG-Modal-Body');
    const variant = activeProd.variants.find(v => 
      v.option1 === activeOptions.option1 && 
      v.option2 === activeOptions.option2 && 
      v.option3 === activeOptions.option3
    ) || activeProd.variants[0];

    let optHtml = '';
    activeProd.options.forEach((opt, i) => {
      const idx = i + 1;
      const vals = [...new Set(activeProd.variants.map(v => v[`option${idx}`]))];
      
      optHtml += `<label class="qv-label">${opt.name}</label>`;
      
      if(opt.name.toLowerCase().includes('color')) {
        optHtml += `<div class="qv-swatches">` + vals.map(v => `
          <div class="qv-swatch ${activeOptions[`option${idx}`] === v ? 'selected' : ''}" 
               onclick="setGGOpt(${idx}, '${v}')">${v}</div>
        `).join('') + `</div>`;
      } else {
        optHtml += `<select class="qv-select" onchange="setGGOpt(${idx}, this.value)">` + vals.map(v => `
          <option value="${v}" ${activeOptions[`option${idx}`] === v ? 'selected' : ''}>${v}</option>
        `).join('') + `</select>`;
      }
    });

    body.innerHTML = `
      <div class="qv-left"><img src="${variant.featured_image ? variant.featured_image.src : activeProd.featured_image}"></div>
      <div class="qv-right">
        <h3 class="qv-title">${activeProd.title}</h3>
        <p class="qv-price">$${(variant.price / 100).toFixed(2)}</p>
        <div class="qv-desc">${activeProd.description.substring(0, 180)}...</div>
        ${optHtml}
        <button class="qv-atc-btn" onclick="runGGAdd(${variant.id})">ADD TO CART &nbsp; &rarr;</button>
      </div>
    `;
  }

  window.runGGAdd = async function(id) {
    const btn = document.querySelector('.qv-atc-btn');
    btn.innerText = "Adding...";
    
    let items = [{ id: id, quantity: 1 }];
    
    const selections = Object.values(activeOptions).filter(x => x).map(x => x.toLowerCase());
    if(selections.includes('black') && (selections.includes('medium') || selections.includes('m'))) {
      const res = await fetch(`/products/${BONUS_H}.js`);
      if(res.ok) {
        const bonus = await res.json();
        if(bonus.variants[0]) items.push({ id: bonus.variants[0].id, quantity: 1 });
      }
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(() => {
      btn.innerText = "Added!";
      setTimeout(() => { window.location.reload(); }, 1000);
    });
  };

  // Run on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% schema %}
{
  "name": "Gift Guide Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tisso vision in the wild" },
    { "type": "collection", "id": "collection", "label": "Collection" }
  ],
  "presets": [{ "name": "Gift Guide Products" }]
}
{% endschema %}