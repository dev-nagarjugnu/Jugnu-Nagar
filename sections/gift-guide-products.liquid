{% comment %}
  Gift Guide Products Section
  - Heading: Lustria 36px
  - Grid: 3x2, 20px gap
  - Features: Selectable products, Quick-view popup, Automatic bonus product logic
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Lustria&family=Jost:wght@400;500&display=swap" rel="stylesheet">

<div class="gg-products-wrapper">
  <h2 class="gg-products__heading">{{ section.settings.heading | default: 'Tisso vison in the wild' }}</h2>

  <div class="gg-products__grid">
    {%- assign products_to_show = section.settings.product_list -%}
    
    {%- for product in products_to_show limit: 6 -%}
      <div class="gg-products__card">
        <img
          src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}"
          alt="{{ product.title | escape }}"
          class="gg-products__image"
          loading="lazy"
          width="433"
          height="444"
        >
        
        {% comment %} Data passed to JS for the popup {% endcomment %}
        <button
          type="button"
          class="gg-products__plus-btn"
          aria-label="Open quick view"
          data-product-handle="{{ product.handle }}"
          onclick="initQuickView(this)"
        >
          <span>+</span>
        </button>

        {% comment %} JSON data for the specific product logic {% endcomment %}
        <script type="application/json" id="ProductJson-{{ product.handle }}">
          {{ product | json }}
        </script>
      </div>
    {%- endfor -%}
  </div>
</div>

{% comment %} POPUP MODAL {% endcomment %}
<div id="gg-modal" class="gg-modal">
  <div class="gg-modal__overlay" onclick="closeGGModal()"></div>
  <div class="gg-modal__container">
    <button class="gg-modal__close" onclick="closeGGModal()">&times;</button>
    <div class="gg-modal__content" id="gg-modal-body">
      {% comment %} Content dynamically injected by JS {% endcomment %}
    </div>
  </div>
</div>

<style>
  .gg-products-wrapper {
    max-width: 1440px;
    margin: 60px auto;
    padding: 0 50px;
    font-family: 'Jost', sans-serif;
  }

  .gg-products__heading {
    font-family: 'Lustria', serif;
    font-size: 36px;
    font-weight: 400;
    margin-bottom: 40px;
    color: #000000;
  }

  .gg-products__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .gg-products__card {
    position: relative;
    line-height: 0;
  }

  .gg-products__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .gg-products__plus-btn {
    position: absolute;
    bottom: 24px;
    right: 24px;
    width: 32px;
    height: 32px;
    background: #FFFFFF;
    border: 1px solid #000000;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    transition: transform 0.2s ease;
  }

  .gg-products__plus-btn:hover {
    transform: scale(1.1);
    background: #000000;
    color: #FFFFFF;
  }

  /* MODAL STYLES */
  .gg-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: none;
    z-index: 10000;
    align-items: center;
    justify-content: center;
  }

  .gg-modal.is-active { display: flex; }

  .gg-modal__overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.4);
  }

  .gg-modal__container {
    position: relative;
    background: #FFFFFF;
    width: 100%;
    max-width: 800px;
    padding: 40px;
    display: flex;
    gap: 30px;
  }

  .gg-modal__close {
    position: absolute;
    top: 10px;
    right: 15px;
    background: none;
    border: none;
    font-size: 30px;
    cursor: pointer;
  }

  /* MODAL CONTENT LAYOUT */
  .gg-qv { display: flex; gap: 30px; width: 100%; }
  .gg-qv__image { width: 350px; flex-shrink: 0; }
  .gg-qv__image img { width: 100%; height: auto; display: block; }
  .gg-qv__info { flex-grow: 1; display: flex; flex-direction: column; }
  .gg-qv__title { font-size: 24px; font-weight: 500; margin: 0 0 10px 0; }
  .gg-qv__price { font-size: 18px; margin-bottom: 15px; }
  .gg-qv__desc { font-size: 14px; line-height: 1.5; color: #666; margin-bottom: 20px; }

  /* VARIANTS */
  .gg-qv__label { font-size: 13px; font-weight: 500; margin-bottom: 8px; display: block; }
  .gg-qv__option-group { margin-bottom: 20px; }
  
  .gg-qv__swatches { display: flex; gap: 10px; }
  .gg-qv__swatch {
    padding: 8px 16px;
    border: 1px solid #ddd;
    cursor: pointer;
    font-size: 13px;
  }
  .gg-qv__swatch.is-selected { border-color: #000; background: #000; color: #fff; }
  
  .gg-qv__select {
    width: 100%;
    height: 45px;
    border: 1px solid #000;
    padding: 0 10px;
    font-family: inherit;
  }

  .gg-qv__atc {
    background: #000;
    color: #fff;
    width: 100%;
    height: 50px;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    font-weight: 500;
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  @media (max-width: 768px) {
    .gg-products__grid { grid-template-columns: 1fr; }
    .gg-modal__container { flex-direction: column; padding: 20px; max-width: 90%; }
    .gg-qv { flex-direction: column; }
    .gg-qv__image { width: 100%; }
  }
</style>

<script>
  let currentProduct = null;
  let selectedOptions = {};

  const bonusProductHandle = "{{ section.settings.bonus_product.handle }}";

  function initQuickView(btn) {
    const handle = btn.dataset.productHandle;
    const productData = JSON.parse(document.getElementById(`ProductJson-${handle}`).textContent);
    
    currentProduct = productData;
    selectedOptions = {
      option1: productData.variants[0].option1,
      option2: productData.variants[0].option2,
      option3: productData.variants[0].option3
    };

    renderModal();
    document.getElementById('gg-modal').classList.add('is-active');
    document.body.style.overflow = 'hidden';
  }

  function renderModal() {
    const modalBody = document.getElementById('gg-modal-body');
    const variant = getSelectedVariant();
    
    // Logic to build color swatches (assumed Option 1) and size dropdown (Option 2)
    let colorHtml = '';
    const colorOptions = [...new Set(currentProduct.variants.map(v => v.option1))];
    colorOptions.forEach(opt => {
      colorHtml += `<div class="gg-qv__swatch ${selectedOptions.option1 === opt ? 'is-selected' : ''}" onclick="updateOption('option1', '${opt}')">${opt}</div>`;
    });

    let sizeHtml = '';
    const sizeOptions = [...new Set(currentProduct.variants.map(v => v.option2))];
    sizeOptions.forEach(opt => {
      sizeHtml += `<option value="${opt}" ${selectedOptions.option2 === opt ? 'selected' : ''}>${opt}</option>`;
    });

    modalBody.innerHTML = `
      <div class="gg-qv">
        <div class="gg-qv__image"><img src="${currentProduct.featured_image}"></div>
        <div class="gg-qv__info">
          <h3 class="gg-qv__title">${currentProduct.title}</h3>
          <p class="gg-qv__price">$${(variant.price / 100).toFixed(2)}</p>
          <div class="gg-qv__desc">${currentProduct.description}</div>
          
          <div class="gg-qv__option-group">
            <span class="gg-qv__label">Color</span>
            <div class="gg-qv__swatches">${colorHtml}</div>
          </div>

          <div class="gg-qv__option-group">
            <span class="gg-qv__label">Size</span>
            <select class="gg-qv__select" onchange="updateOption('option2', this.value)">
              ${sizeHtml}
            </select>
          </div>

          <button class="gg-qv__atc" id="atc-btn" onclick="handleAddToCart()">
            ADD TO CART &nbsp; &rarr;
          </button>
        </div>
      </div>
    `;
  }

  function updateOption(name, value) {
    selectedOptions[name] = value;
    renderModal();
  }

  function getSelectedVariant() {
    return currentProduct.variants.find(v => 
      v.option1 === selectedOptions.option1 && 
      v.option2 === selectedOptions.option2
    ) || currentProduct.variants[0];
  }

  function closeGGModal() {
    document.getElementById('gg-modal').classList.remove('is-active');
    document.body.style.overflow = '';
  }

  async function handleAddToCart() {
    const variant = getSelectedVariant();
    const btn = document.getElementById('atc-btn');
    btn.innerText = "Adding...";

    let itemsToAdd = [{ id: variant.id, quantity: 1 }];

    // SPECIAL LOGIC: BLACK AND MEDIUM
    const color = variant.option1.toLowerCase();
    const size = variant.option2.toLowerCase();

    if (color === 'black' && size === 'medium') {
      // Get bonus product ID - In real Shopify, you'd fetch the variant ID.
      // For this test, we assume there's a variant available for the Soft Winter Jacket.
      const bonusRes = await fetch(`/products/${bonusProductHandle}.js`);
      const bonusProd = await bonusRes.json();
      itemsToAdd.push({ id: bonusProd.variants[0].id, quantity: 1 });
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: itemsToAdd })
    })
    .then(res => res.json())
    .then(data => {
      btn.innerText = "Added!";
      setTimeout(() => { closeGGModal(); btn.innerText = "ADD TO CART →"; }, 1000);
      // Trigger theme cart refresh if needed
      if(window.refreshCart) window.refreshCart();
    });
  }
</script>

{% schema %}
{
  "name": "Gift Guide Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Select 6 Products",
      "limit": 6
    },
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Soft Winter Jacket (Bonus Product)"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Products"
    }
  ]
}
{% endschema %}