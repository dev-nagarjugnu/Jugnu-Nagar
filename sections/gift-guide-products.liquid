{% comment %}
  Gift Guide Products Section
  - Heading: Lustria font 36px
  - Grid: 3 columns, 20px gap
  - Popup: Dynamic variant rendering
  - Special Logic: Auto-adds "Soft Winter Jacket" if Black + Medium is selected
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Lustria&family=Jost:wght@400;500&display=swap" rel="stylesheet">

<div class="gg-products-container">
  <h2 class="gg-products__heading">{{ section.settings.heading }}</h2>

  <div class="gg-products__grid">
    {% comment %} 
      Using the collection assigned in schema, or defaulting to 'gift-guide' 
    {% endcomment %}
    {% assign collection = collections[section.settings.collection] | default: collections['gift-guide'] %}
    
    {% for product in collection.products limit: 6 %}
      <div class="gg-products__card">
        <div class="gg-products__image-wrapper">
          <img
            src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}"
            alt="{{ product.title | escape }}"
            class="gg-products__image"
            loading="lazy"
            width="433"
            height="444"
          >
          <button
            type="button"
            class="gg-products__plus-btn"
            aria-label="Quick View"
            onclick="openQuickView('{{ product.handle }}')"
          >
            <span>+</span>
          </button>
        </div>
        
        {% comment %} Detailed Product Data for JS Logic {% endcomment %}
        <script type="application/json" id="ProductJson-{{ product.handle }}">
          {{ product | json }}
        </script>
      </div>
    {% endfor %}
  </div>
</div>

{% comment %} POPUP MODAL STRUCTURE {% endcomment %}
<div id="gg-modal" class="gg-modal" aria-hidden="true">
  <div class="gg-modal__overlay" onclick="closeQuickView()"></div>
  <div class="gg-modal__inner">
    <button class="gg-modal__close" onclick="closeQuickView()">&times;</button>
    <div id="gg-modal-content">
      {% comment %} Content Injected by JavaScript {% endcomment %}
    </div>
  </div>
</div>

<style>
  /* FONTS */
  .gg-products-container {
    max-width: 1440px;
    margin: 80px auto;
    padding: 0 50px;
    font-family: 'Jost', sans-serif;
  }

  .gg-products__heading {
    font-family: 'Lustria', serif;
    font-size: 36px;
    font-weight: 400;
    color: #000000;
    margin-bottom: 40px;
  }

  /* GRID - Figma Specs */
  .gg-products__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .gg-products__card {
    position: relative;
    width: 100%;
  }

  .gg-products__image-wrapper {
    position: relative;
    aspect-ratio: 433 / 444;
    overflow: hidden;
  }

  .gg-products__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .gg-products__card:hover .gg-products__image {
    transform: scale(1.05);
  }

  /* PLUS BUTTON */
  .gg-products__plus-btn {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 20px;
    z-index: 2;
  }

  .gg-products__plus-btn:hover {
    background: #000000;
    color: #FFFFFF;
  }

  /* MODAL */
  .gg-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .gg-modal.active { display: flex; }

  .gg-modal__overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
  }

  .gg-modal__inner {
    position: relative;
    background: #FFFFFF;
    width: 100%;
    max-width: 850px;
    min-height: 450px;
    padding: 40px;
    z-index: 1001;
    display: flex;
  }

  .gg-modal__close {
    position: absolute;
    top: 15px;
    right: 20px;
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    line-height: 1;
  }

  /* QUICK VIEW CONTENT */
  .qv-layout { display: flex; gap: 40px; width: 100%; }
  .qv-image { width: 380px; flex-shrink: 0; }
  .qv-image img { width: 100%; height: auto; }
  .qv-details { flex-grow: 1; display: flex; flex-direction: column; }
  
  .qv-title { font-size: 24px; font-weight: 500; margin: 0 0 10px 0; text-transform: uppercase; }
  .qv-price { font-size: 20px; margin-bottom: 20px; }
  .qv-desc { font-size: 14px; color: #444; line-height: 1.6; margin-bottom: 25px; }

  .qv-label { display: block; font-size: 12px; font-weight: 500; text-transform: uppercase; margin-bottom: 10px; }
  
  .qv-swatches { display: flex; gap: 10px; margin-bottom: 20px; }
  .qv-swatch { 
    padding: 8px 16px; 
    border: 1px solid #E5E5E5; 
    cursor: pointer; 
    font-size: 13px; 
  }
  .qv-swatch.selected { border-color: #000; background: #000; color: #fff; }

  .qv-select { 
    width: 100%; 
    height: 45px; 
    border: 1px solid #000; 
    padding: 0 15px; 
    margin-bottom: 30px;
    font-family: inherit;
  }

  .qv-atc {
    background: #000;
    color: #fff;
    width: 100%;
    height: 55px;
    border: none;
    text-transform: uppercase;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .gg-products__grid { grid-template-columns: 100%; }
    .gg-modal__inner { flex-direction: column; width: 90%; max-height: 90vh; overflow-y: auto; padding: 20px; }
    .qv-layout { flex-direction: column; gap: 20px; }
    .qv-image { width: 100%; }
  }
</style>

<script>
  let activeProduct = null;
  let activeOptions = { option1: null, option2: null };

  // This is the handle for the bonus product from the requirements
  const BONUS_HANDLE = "soft-winter-jacket";

  function openQuickView(handle) {
    const dataEl = document.getElementById(`ProductJson-${handle}`);
    if(!dataEl) return;
    
    activeProduct = JSON.parse(dataEl.textContent);
    activeOptions.option1 = activeProduct.variants[0].option1;
    activeOptions.option2 = activeProduct.variants[0].option2;

    renderPopup();
    document.getElementById('gg-modal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeQuickView() {
    document.getElementById('gg-modal').classList.remove('active');
    document.body.style.overflow = '';
  }

  function updateOption(index, value) {
    activeOptions[`option${index}`] = value;
    renderPopup();
  }

  function renderPopup() {
    const container = document.getElementById('gg-modal-content');
    const variant = activeProduct.variants.find(v => v.option1 === activeOptions.option1 && v.option2 === activeOptions.option2) || activeProduct.variants[0];

    // Build Swatches for Color (Assume Option 1 is Color)
    const colors = [...new Set(activeProduct.variants.map(v => v.option1))];
    let colorHtml = colors.map(c => `
      <div class="qv-swatch ${activeOptions.option1 === c ? 'selected' : ''}" onclick="updateOption(1, '${c}')">${c}</div>
    `).join('');

    // Build Dropdown for Size (Assume Option 2 is Size)
    const sizes = [...new Set(activeProduct.variants.map(v => v.option2))];
    let sizeHtml = sizes.map(s => `
      <option value="${s}" ${activeOptions.option2 === s ? 'selected' : ''}>${s}</option>
    `).join('');

    container.innerHTML = `
      <div class="qv-layout">
        <div class="qv-image"><img src="${activeProduct.featured_image}"></div>
        <div class="qv-details">
          <h3 class="qv-title">${activeProduct.title}</h3>
          <p class="qv-price">$${(variant.price / 100).toFixed(2)}</p>
          <div class="qv-desc">${activeProduct.description.substring(0, 180)}...</div>
          
          <label class="qv-label">Color</label>
          <div class="qv-swatches">${colorHtml}</div>

          <label class="qv-label">Size</label>
          <select class="qv-select" onchange="updateOption(2, this.value)">
            ${sizeHtml}
          </select>

          <button class="qv-atc" onclick="addToCart(${variant.id})">
            ADD TO CART &nbsp; &rarr;
          </button>
        </div>
      </div>
    `;
  }

  async function addToCart(variantId) {
    const btn = document.querySelector('.qv-atc');
    btn.innerHTML = "Adding...";

    let items = [{ id: variantId, quantity: 1 }];

    // RECRUITER SPECIAL LOGIC: BLACK AND MEDIUM
    const isBlack = activeOptions.option1.toLowerCase() === 'black';
    const isMedium = activeOptions.option2.toLowerCase() === 'medium';

    if (isBlack && isMedium) {
      try {
        const bonusResponse = await fetch(`/products/${BONUS_HANDLE}.js`);
        const bonusProduct = await bonusResponse.json();
        if(bonusProduct && bonusProduct.variants[0]) {
          items.push({ id: bonusProduct.variants[0].id, quantity: 1 });
        }
      } catch(e) { console.error("Bonus product not found"); }
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(res => res.json())
    .then(data => {
      btn.innerHTML = "Added Successfully!";
      setTimeout(() => {
        closeQuickView();
        window.location.reload(); // Refresh to show cart update
      }, 1000);
    });
  }
</script>

{% schema %}
{
  "name": "Gift Guide Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Products"
    }
  ]
}
{% endschema %}